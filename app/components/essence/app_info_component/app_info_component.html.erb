<div <%= tag.attributes **html_options %>>
  <div>
    <h2 class="app-info-headline"><%= headline %></h2>
    <% if subheadline? %>
      <h3 class="app-info-sub-headline"><%= subheadline %></h3>
    <% end %>
    <% if content? %>
      <%= render Essence::ParagraphComponent.new(class: 'app-info-text', style: 'margin: 30px 0;') do %>
        <%= content %>
      <% end %>
    <% end %>
    <% if link_text? && link_url? %>
      <%= render Essence::LinkComponent.new(name: link_text, url: link_url, display_as: :button) %>
    <% end %>
  </div>
  <% if image_path? %>
    <div>
      <%= image_tag image_path, class: 'app-info-logo' %>
    </div>
  <% end %>
</div>
